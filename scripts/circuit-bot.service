[Unit]
Description=Circuit Perth Telegram Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=circuit
Group=circuit
WorkingDirectory=/opt/circuit-perth-bot
ExecStart=/opt/circuit-perth-bot/.venv/bin/circuit-bot run
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/circuit-perth-bot/data

[Install]
WantedBy=multi-user.target
